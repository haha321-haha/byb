# Waffo Pancake SDK — test mode
WAFFO_ENVIRONMENT=test
WAFFO_MERCHANT_ID=MER_your_test_merchant_id
WAFFO_STORE_ID=STO_your_test_store_id
WAFFO_PRODUCT_ID=PROD_your_test_product_id

# Store the base64 of your TEST private key. Never commit a real key.
WAFFO_PRIVATE_KEY_BASE64=

# Optional public production base URL
BYB_PUBLIC_BASE_URL=
