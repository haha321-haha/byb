# Test Mode credentials. Values must match the reviewed Waffo Test Mode
# artifact exactly — the checkout endpoint rejects anything else.
WAFFO_ENVIRONMENT=test
WAFFO_MERCHANT_ID=MER_4fIWy0Facbl75gjrvAnBae
WAFFO_STORE_ID=STO_27y76CY0tN6xZYUgt6J3YL
WAFFO_PRODUCT_ID=PROD_4HCgyZAZ1EaR1B2PXU9GKD

# Merchant private key (Test Mode). Accepts either:
#   - PEM text ("-----BEGIN PRIVATE KEY----- ..."), or
#   - the bare base64 key body copied straight from the Waffo dashboard
#     .env snippet (e.g. "MIIE...") — the SDK wraps it in PEM headers.
# Never commit a real key.
WAFFO_PRIVATE_KEY=

# Alternative: the base64 of the PEM TEXT itself (decodes to a value that
# contains "-----BEGIN PRIVATE KEY-----"). Set at most one key variable;
# WAFFO_PRIVATE_KEY_BASE64 wins if both are set.
WAFFO_PRIVATE_KEY_BASE64=

# Set after the preview deployment exists, without a trailing slash.
BYB_PUBLIC_BASE_URL=
